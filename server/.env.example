# Names only. Copy to .env or .dev.vars locally. Never commit values.

# Supabase Auth and PostgreSQL
SUPABASE_URL=
# Worker hosted OTP/OAuth uses the anon/public key, never the service role.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase dashboards label this "secret key"; the Worker accepts either name.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=
DATABASE_URL=

# Qwen (Alibaba Cloud Model Studio / QwenCloud Singapore token-plan)
# Local native apps also read repo-root .env.local `qwen-key`.
# Default base URL is token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Default model is qwen3.7-plus.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Cloudflare account / Workers
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 readiness needs a runtime token scoped to read this account/bucket's domain policy.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_MANAGEMENT_API_TOKEN=

# Google Cloud Storage (optional media; also configurable from the admin portal)
GCS_BUCKET=
GCS_SERVICE_ACCOUNT_JSON=

# Encrypts operator_settings overlays (falls back to CACHE_HMAC_SECRET)
OPERATOR_CONFIG_KEY=

# First matching signed-in email is granted admin
ADMIN_BOOTSTRAP_EMAIL=

# Email OTP (Resend)
RESEND_API_KEY=
OTP_FROM_EMAIL=

# Cloudflare Turnstile (`wrangler secret put TURNSTILE_SECRET_KEY`)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Passwordless identifier HMAC (falls back to CACHE_HMAC_SECRET)
PASSWORDLESS_HMAC_SECRET=

# Shared cache
CACHE_HMAC_SECRET=

# HTTP
ADMIN_ORIGIN=
CORS_ALLOWED_ORIGINS=
ENVIRONMENT=
APP_VERSION=
MAX_BODY_BYTES=
LOCAL_DEV_OTP=
