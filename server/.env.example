# Names only. Copy to .env or .dev.vars locally. Never commit values.

# Supabase Auth and PostgreSQL
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=
DATABASE_URL=

# Qwen (Alibaba Cloud Model Studio)
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Cloudflare account / Workers
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Cloudflare Queue
JOB_QUEUE_NAME=

# Email OTP (Resend)
RESEND_API_KEY=
OTP_FROM_EMAIL=

# Cloudflare Turnstile (`wrangler secret put TURNSTILE_SECRET_KEY`)
TURNSTILE_SECRET_KEY=

# Passwordless identifier HMAC (falls back to CACHE_HMAC_SECRET)
PASSWORDLESS_HMAC_SECRET=

# Shared cache
CACHE_HMAC_SECRET=

# HTTP
API_PUBLIC_URL=
ADMIN_ORIGIN=
CORS_ALLOWED_ORIGINS=
ENVIRONMENT=
APP_VERSION=
MAX_BODY_BYTES=
LOCAL_DEV_OTP=

# Observability
LOG_LEVEL=
